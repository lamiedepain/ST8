# Variables d'environnement pour ST88 Planning
# Copier ce fichier vers .env et renseigner vos credentials

# ==============================================================================
# SHAREPOINT - Authentification
# ==============================================================================

# Option 1: Authentification user/password (NTLM)
SHAREPOINT_USERNAME=votre.email@bordeaux-metropole.fr
SHAREPOINT_PASSWORD=votre_mot_de_passe

# Option 2: Authentification OAuth2 (Client ID/Secret)
SHAREPOINT_TENANT_ID=b3dd23de-593f-4d74-bcf9-f035c1a2eb24
SHAREPOINT_CLIENT_ID=votre_client_id
SHAREPOINT_CLIENT_SECRET=votre_client_secret

# ==============================================================================
# FLASK - Configuration
# ==============================================================================

SECRET_KEY=votre-cle-secrete-unique-et-aleatoire
FLASK_DEBUG=True

# ==============================================================================
# NOTES
# ==============================================================================
# - Ne jamais commiter ce fichier avec de vrais credentials
# - Utiliser .env.example comme template
# - Le fichier .env est ignoré par Git
